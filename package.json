{
  "name": "office-pet",
  "productName": "OfficePet",
  "version": "0.3.0",
  "description": "사무실 펫 - 업무시간에 같이 지내는 도트 펫",
  "author": "동훈",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "build": {
    "appId": "kr.dhoon.officepet",
    "productName": "OfficePet",
    "artifactName": "OfficePet-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "사무실 펫",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dhoon-CNU",
        "repo": "office-pet"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
